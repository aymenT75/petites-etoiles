---
import '../styles/global.css';
import MusicButton from '../components/MusicButton.astro';
interface Props { title?: string; }
const { title = 'Petites Étoiles | نجوم صغيرة — Musique pour enfants' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!DOCTYPE html>
<html lang="fr" data-lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Petites Étoiles — Les histoires des Prophètes en chansons, racontées par les animaux. Une nouvelle histoire chaque semaine, en français et en arabe." />
  <meta property="og:title" content="Petites Étoiles | نجوم صغيرة" />
  <meta property="og:description" content="Les histoires des Prophètes en chansons, racontées par les animaux." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={`${base}/logo-512.png`} />
  <meta name="theme-color" content="#f7e3c4" />
  <link rel="icon" type="image/png" sizes="64x64" href={`${base}/favicon-64.png`} />
  <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@600;700;800&family=Baloo+Bhaijaan+2:wght@500;600;700&display=swap" rel="stylesheet" />
  <!-- Amiri réduite au seul signe ﷺ (absent des polices du site) -->
  <link href="https://fonts.googleapis.com/css2?family=Amiri&text=%EF%B7%BA&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
  <MusicButton />
</body>
</html>
