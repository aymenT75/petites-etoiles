---
import ShopMenu from './ShopMenu.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="divider"></div>
<section id="boutique">
  <div class="container">
    <div class="section-header">
      <div class="section-tag" data-i18n="shop.tag">Boutique</div>
      <h2 class="section-title" data-i18n="shop.title">L'univers <em>Petites Étoiles</em></h2>
      <p class="section-desc" data-i18n="shop.desc">Musique, livres illustrés et goodies pour accompagner vos enfants dans la découverte des Prophètes.</p>
    </div>

    <ShopMenu />

    <div class="products-grid">
      <!--
        Produits mis en pause pour l'instant (l'utilisateur a demandé de se concentrer
        sur les t-shirts) — code conservé pour les réactiver plus tard.

      Pack Digital
      <div class="product-card reveal" data-product='{"id":1,"name":"Pack Digital — Adam ✕ 4 langues","price":4.99,"icon":"🎵"}'>
        <span class="product-badge new" data-i18n="shop.new">Nouveau</span>
        <div class="product-image">
          <div class="product-image-bg"></div>
          <div class="product-image-emoji">🎵</div>
        </div>
        <div class="product-body">
          <div class="product-name" data-i18n="prod1.name">Pack Digital — Adam ✕ 4 langues</div>
          <div class="product-desc" data-i18n="prod1.desc">Téléchargez les 4 singles haute qualité (MP3 320kbps) : arabe, anglais, ourdou, indonésien. Idéal pour écouter sans connexion.</div>
          <div class="product-footer">
            <div class="product-price"><span class="currency">€</span>4,99</div>
            <button class="add-to-cart" onclick="addToCart(this)" data-i18n="shop.add">+ Panier</button>
          </div>
        </div>
      </div>

      Livre illustré
      <div class="product-card reveal reveal-delay-1" data-product='{"id":2,"name":"Livre illustré — Adam, le Premier Homme","price":14.99,"icon":"📖"}'>
        <span class="product-badge soon" data-i18n="shop.soon">Pré-commande</span>
        <div class="product-image">
          <div class="product-image-bg"></div>
          <div class="product-image-emoji">📖</div>
        </div>
        <div class="product-body">
          <div class="product-name" data-i18n="prod2.name">Livre illustré — Adam, le Premier Homme</div>
          <div class="product-desc" data-i18n="prod2.desc">Un album jeunesse magnifiquement illustré qui retrace l'histoire du Prophète Adam عليه السلام. Bilingue français-arabe. Pour les 3–8 ans.</div>
          <div class="product-footer">
            <div class="product-price"><span class="currency">€</span>14,99</div>
            <button class="add-to-cart" onclick="addToCart(this)" data-i18n="shop.preorder">Pré-commander</button>
          </div>
        </div>
      </div>
      -->

      <!-- T-shirts (collection) -->
      <a href={`${base}/t-shirts`} class="product-card reveal reveal-delay-2" style="display:block;text-decoration:none;color:inherit">
        <span class="product-badge new">Nouveau</span>
        <div class="product-image product-image--photo">
          <div class="product-image-bg" style="background:#f6f4ee"></div>
          <img src={`${base}/tshirt-younes.jpg`} alt="T-shirts — Les héros des histoires" class="product-photo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
          <div class="product-image-fallback" style="display:none"><span>👕</span></div>
        </div>
        <div class="product-body">
          <div class="product-name">T-shirts — Les héros des histoires</div>
          <div class="product-desc">Une scène de chaque histoire, avec son petit animal : Léo, Alwa, Qitta, Qitmir, Nilo… 16 modèles, tailles 2 à 14 ans.</div>
          <div class="product-footer">
            <div class="product-price" style="font-size:0.95rem;color:var(--gold);font-weight:700">Voir la collection →</div>
          </div>
        </div>
      </a>

      <!-- Gourdes -->
      <a href={`${base}/gourdes`} class="product-card reveal reveal-delay-1" style="display:block;text-decoration:none;color:inherit">
        <span class="product-badge new">Nouveau</span>
        <div class="product-image product-image--photo">
          <div class="product-image-bg" style="background:linear-gradient(135deg,#0f1c33,#1a2f4d)"></div>
          <img src={`${base}/collection-gourdes.jpg`} alt="Gourdes — Les Prophètes" class="product-photo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
          <div class="product-image-fallback" style="display:none"><span>🥤</span></div>
        </div>
        <div class="product-body">
          <div class="product-name">Gourdes — Les Prophètes</div>
          <div class="product-desc">Nouveau : Nilo, Sabra, Léo et Qitta sur des gourdes inox pastel. Et toujours Mohamed, Adam, Souleymane, Moussa.</div>
          <div class="product-footer">
            <div class="product-price" style="font-size:0.95rem;color:var(--gold);font-weight:700">Voir la collection →</div>
          </div>
        </div>
      </a>

      <!-- Coques de téléphone -->
      <a href={`${base}/coques-telephone`} class="product-card reveal reveal-delay-2" style="display:block;text-decoration:none;color:inherit">
        <span class="product-badge new">Nouveau</span>
        <div class="product-image product-image--photo">
          <div class="product-image-bg" style="background:linear-gradient(135deg,#0f1c33,#1a2f4d)"></div>
          <img src={`${base}/collection-coques.jpg`} alt="Coques de téléphone — Les Prophètes" class="product-photo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
          <div class="product-image-fallback" style="display:none"><span>📱</span></div>
        </div>
        <div class="product-body">
          <div class="product-name">Coques de téléphone — Les Prophètes</div>
          <div class="product-desc">Nouveau : Alwa, Salma, Qitta et Hamouda en aquarelle. Et toujours Mohamed, Adam, Souleymane, Nouh.</div>
          <div class="product-footer">
            <div class="product-price" style="font-size:0.95rem;color:var(--gold);font-weight:700">Voir la collection →</div>
          </div>
        </div>
      </a>

      <!-- Sweats à capuche -->
      <a href={`${base}/sweats`} class="product-card reveal reveal-delay-3" style="display:block;text-decoration:none;color:inherit">
        <span class="product-badge new">Nouveau</span>
        <div class="product-image product-image--photo">
          <div class="product-image-bg" style="background:linear-gradient(135deg,#0f1c33,#1a2f4d)"></div>
          <img src={`${base}/collection-sweats.jpg`} alt="Sweats à capuche — Les Prophètes" class="product-photo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
          <div class="product-image-fallback" style="display:none"><span>🧥</span></div>
        </div>
        <div class="product-body">
          <div class="product-name">Sweats à capuche — Les Prophètes</div>
          <div class="product-desc">Nouveau : Qitmir, Hamouda, Léo et Alwa. Et toujours Mohamed, Adam, Souleymane, Nouh.</div>
          <div class="product-footer">
            <div class="product-price" style="font-size:0.95rem;color:var(--gold);font-weight:700">Voir la collection →</div>
          </div>
        </div>
      </a>

      <!-- Pyjamas -->
      <a href={`${base}/pyjamas`} class="product-card reveal" style="display:block;text-decoration:none;color:inherit">
        <span class="product-badge new">Nouveau</span>
        <div class="product-image product-image--photo">
          <div class="product-image-bg" style="background:linear-gradient(135deg,#0f1c33,#1a2f4d)"></div>
          <img src={`${base}/collection-pyjamas.jpg`} alt="Pyjamas — Les Prophètes" class="product-photo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
          <div class="product-image-fallback" style="display:none"><span>🛌</span></div>
        </div>
        <div class="product-body">
          <div class="product-name">Pyjamas — Les Prophètes</div>
          <div class="product-desc">Nouveau : Qitmir, Léo, Wael et Sabra, pantalon semé de lunes. Et toujours Mohamed, Adam, Souleymane, Nouh, Moussa.</div>
          <div class="product-footer">
            <div class="product-price" style="font-size:0.95rem;color:var(--gold);font-weight:700">Voir la collection →</div>
          </div>
        </div>
      </a>

      <!-- Coffrets cadeaux -->
      <a href={`${base}/coffrets`} class="product-card reveal reveal-delay-1" style="display:block;text-decoration:none;color:inherit">
        <span class="product-badge new">Nouveau</span>
        <div class="product-image product-image--photo">
          <div class="product-image-bg" style="background:linear-gradient(135deg,#cfe8f5,#e8f4fb)"></div>
          <img src={`${base}/collection-coffrets.jpg`} alt="Coffrets cadeaux — Les Prophètes" class="product-photo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
          <div class="product-image-fallback" style="display:none"><span>🎁</span></div>
        </div>
        <div class="product-body">
          <div class="product-name">Coffrets cadeaux — Les Prophètes</div>
          <div class="product-desc">Nouveau : le t-shirt d'une histoire, la peluche de son animal et des stickers, prêts à offrir.</div>
          <div class="product-footer">
            <div class="product-price" style="font-size:0.95rem;color:var(--gold);font-weight:700">Voir la collection →</div>
          </div>
        </div>
      </a>

      <!-- Jeu de cartes -->
      <a href={`${base}/jeu-de-cartes`} class="product-card reveal reveal-delay-2" style="display:block;text-decoration:none;color:inherit">
        <span class="product-badge new">Nouveau</span>
        <div class="product-image product-image--photo">
          <div class="product-image-bg" style="background:linear-gradient(135deg,#cfe0cb,#e4efe0)"></div>
          <img src={`${base}/jeu-de-cartes-pack.jpg`} alt="Jeu des 7 familles des Prophètes — coffret" class="product-photo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
          <div class="product-image-fallback" style="display:none"><span>🃏</span></div>
        </div>
        <div class="product-body">
          <div class="product-name">Jeu des 7 familles — Les Prophètes</div>
          <div class="product-desc">Jeu de cartes éducatif et ludique pour découvrir les Prophètes et personnages du Coran en famille.</div>
          <div class="product-footer">
            <div class="product-price" style="font-size:0.95rem;color:var(--gold);font-weight:700">Voir le jeu →</div>
          </div>
        </div>
      </a>

      <!-- Lunchbox -->
      <a href={`${base}/lunchbox`} class="product-card reveal reveal-delay-3" style="display:block;text-decoration:none;color:inherit">
        <span class="product-badge new">Nouveau</span>
        <div class="product-image product-image--photo">
          <div class="product-image-bg" style="background:linear-gradient(135deg,#0f1c33,#1a2f4d)"></div>
          <img src={`${base}/collection-lunchbox.jpg`} alt="Lunchbox — Les Prophètes" class="product-photo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
          <div class="product-image-fallback" style="display:none"><span>🍱</span></div>
        </div>
        <div class="product-body">
          <div class="product-name">Lunchbox — Les Prophètes</div>
          <div class="product-desc">Nouveau : Amira, Arnoub, Salam et Nilo. Et toujours Mohamed, Souleymane, Nouh, Moussa.</div>
          <div class="product-footer">
            <div class="product-price" style="font-size:0.95rem;color:var(--gold);font-weight:700">Voir la collection →</div>
          </div>
        </div>
      </a>

      <!-- Peluches & cadeaux -->
      <a href={`${base}/cadeaux`} class="product-card reveal" style="display:block;text-decoration:none;color:inherit">
        <span class="product-badge soon">Bientôt</span>
        <div class="product-image product-image--photo">
          <div class="product-image-bg" style="background:#f3e6d0"></div>
          <img src={`${base}/cadeaux-peluches.jpg`} alt="Peluches des héros des histoires" class="product-photo" loading="lazy" />
        </div>
        <div class="product-body">
          <div class="product-name">Peluches &amp; cadeaux</div>
          <div class="product-desc">Les peluches des petits animaux, la veilleuse étoilée et le vinyle magnétique qui joue toutes les chansons des histoires.</div>
          <div class="product-footer">
            <div class="product-price" style="font-size:0.95rem;color:var(--gold);font-weight:700">Découvrir →</div>
          </div>
        </div>
      </a>

      <!-- Albums illustrés -->
      <div class="product-card reveal">
        <span class="product-badge soon">Bientôt</span>
        <div class="product-image">
          <div class="product-image-bg"></div>
          <div class="product-image-emoji">📖</div>
        </div>
        <div class="product-body">
          <div class="product-name">Albums illustrés — Les Prophètes</div>
          <div class="product-desc">Livres jeunesse magnifiquement illustrés qui retracent les histoires des Prophètes. Bientôt disponible.</div>
          <div class="product-footer">
            <div class="product-price" style="font-size:0.95rem;color:var(--text-muted);font-weight:600">Bientôt disponible</div>
          </div>
        </div>
      </div>

