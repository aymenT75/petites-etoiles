        <span class="product-badge sale" data-i18n="shop.sale">-25%</span>
        <div class="product-image">
          <div class="product-image-bg"></div>
          <div class="product-image-emoji">⭐</div>
        </div>
        <div class="product-body">
          <div class="product-name" data-i18n="prod5.name">Pack Famille — Tout-en-un</div>
          <div class="product-desc" data-i18n="prod5.desc">Pack complet : 4 singles digitaux + livre illustré (pré-commande) + poster. La meilleure façon d'offrir l'univers Petites Étoiles.</div>
          <div class="product-footer">
            <div class="product-price"><span class="currency">€</span>29,99 <span class="old-price">€ 39,97</span></div>
