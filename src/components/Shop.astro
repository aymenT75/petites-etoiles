    <div style="text-align:center;margin-top:2.5rem">
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/t-shirts`} class="btn-secondary">👕 Voir tous les t-shirts</a>
    </div>
  </div>
</section>
