      <div class="product-card reveal reveal-delay-1" data-product='{"id":6,"name":"Cahier d&apos;activités — Les Prophètes","price":9.99,"icon":"📝"}'>
        <div class="product-image">
          <div class="product-image-bg"></div>
          <div class="product-image-emoji">📝</div>
        </div>
        <div class="product-body">
          <div class="product-name" data-i18n="prod6.name">Cahier d'activités — Les Prophètes</div>
          <div class="product-desc" data-i18n="prod6.desc">50 activités éducatives (coloriages, quiz, jeux de lettres arabes) autour des histoires des Prophètes. Format A4 imprimable.</div>
          <div class="product-footer">
            <div class="product-price"><span class="currency">€</span>9,99</div>
            <button class="add-to-cart" onclick="addToCart(this)" data-i18n="shop.add">+ Panier</button>
          </div>
        </div>
      </div>
      -->
    </div>

    <div style="text-align:center;margin-top:2.5rem">
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/t-shirts`} class="btn-secondary">👕 Voir tous les t-shirts</a>
    </div>
  </div>
</section>
