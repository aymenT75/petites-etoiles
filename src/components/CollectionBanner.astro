---
// Bannière « Nouvelle collection » en tête des pages boutique : une photo de la gamme
// avec les petits animaux des histoires.
interface Props { img: string; alt: string; title: string; text: string }
const { img, alt, title, text } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="collection-banner reveal">
  <img src={`${base}/${img}`} alt={alt} loading="lazy" width="1600" height="1195" />
  <div class="collection-banner-body">
    <span class="collection-banner-tag">✨ Nouvelle collection</span>
    <h2>{title}</h2>
    <p>{text}</p>
    <span class="collection-banner-price">Prix à venir</span>
  </div>
</div>

<style>
  .collection-banner { display: grid; grid-template-columns: 1.4fr 1fr; background: #fff; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-card); margin-bottom: 2.5rem; }
  .collection-banner img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4 / 3; }
  .collection-banner-body { padding: 2rem 2.2rem; display: flex; flex-direction: column; justify-content: center; gap: 0.7rem; }
  .collection-banner-tag { align-self: flex-start; background: var(--mer); color: #fff; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.25rem 0.8rem; border-radius: 999px; }
  .collection-banner h2 { font-family: var(--font-title); font-size: clamp(1.4rem, 2.6vw, 1.9rem); font-weight: 700; line-height: 1.15; }
  .collection-banner p { color: var(--text-muted); font-size: 1rem; line-height: 1.6; }
  .collection-banner-price { color: var(--text-muted); font-weight: 800; font-size: 0.95rem; }
  @media (max-width: 860px) {
    .collection-banner { grid-template-columns: 1fr; }
    .collection-banner-body { padding: 1.4rem 1.4rem 1.6rem; }
  }
</style>
