---
// Bande « nuit » : histoires pas encore sorties (celles en ligne sont dans Stories.astro) + abonnement.
// ﷺ est réservé au Prophète Mohammed ; « عليه السلام » pour les autres Prophètes.
const prophets = [
  { emoji: '🌙', name: 'Lout',      ar: 'لوط',  honor: 'as' },
  { emoji: '🐺', name: 'Youssouf',  ar: 'يوسف', honor: 'as' },
  { emoji: '❄️', name: 'Issa',      ar: 'عيسى', honor: 'as' },
  { emoji: '✨', name: 'Mohammed',  ar: 'محمد', honor: 'saw' },
];
---
<section id="prochains">
  <span class="deco-star" style="left:9%;top:18%" aria-hidden="true">✦</span>
  <span class="deco-star" style="left:22%;bottom:14%;font-size:14px" aria-hidden="true">✦</span>
  <span class="deco-star" style="right:11%;top:26%" aria-hidden="true">✦</span>
  <span class="deco-star" style="right:25%;bottom:18%;font-size:14px" aria-hidden="true">✦</span>
  <div class="container" style="padding:0 1.5rem">
    <h2 class="section-title" data-i18n="upcoming.title">Une nouvelle histoire chaque semaine ✨</h2>
    <p class="section-desc" data-i18n="upcoming.desc">Bientôt sur la chaîne : la saga des Prophètes continue…</p>
  </div>
  <div class="ribbon-wrap">
    <div class="ribbon-track" id="ribbon">
      {[...prophets, ...prophets].map((p, i) => (
        <div class="ribbon-item" aria-hidden={i >= prophets.length ? 'true' : undefined}>
          {p.emoji} <span class="prophet">{p.name} {p.honor === 'saw' ? <span class="honor">ﷺ</span> : <span class="honor-as">عليه السلام</span>}</span> <span class="ar">{p.ar}</span> <span class="badge" data-i18n="upcoming.badge">Bientôt</span>
        </div>
      ))}
    </div>
  </div>
  <a href="https://www.youtube.com/@NajomSaghira?sub_confirmation=1" target="_blank" rel="noopener" class="btn-primary" data-i18n="stories.subscribe">▶ S'abonner à la chaîne</a>
</section>
