---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Cart from '../components/Cart.astro';
import ShopMenu from '../components/ShopMenu.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Nouveaux goodies avec les petits animaux des histoires (bientôt disponibles).
const gifts = [
  { slug: 'peluches',  emoji: '🧸', name: 'Les peluches des héros',
    desc: "Léo le dauphin, Alwa la chamelle, Qitta la chatte, Qitmir le chien, Nilo le crocodile, Salam le serpent… tout doux, à câliner en écoutant leur histoire." },
  { slug: 'veilleuse', emoji: '🌙', name: 'La veilleuse étoilée',
    desc: "Un croissant de lune qui brille doucement, avec Qitmir endormi dessus, et des petites étoiles projetées au mur. Pour s'endormir comme les gens de la Caverne." },
  { slug: 'aimants',   emoji: '🎵', name: 'Le vinyle magnétique',
    desc: "Un petit vinyle aimanté pour le frigo, avec TOUTES les chansons des histoires dedans. On appuie sur ▶ : le disque tourne, s'éclaire, et la chanson commence. Les boutons − et + passent d'une histoire à l'autre. La pochette au choix : Younes, Salih, Maryam, Al-Kahf…" },
];
---

<Layout title="Peluches & cadeaux — Petites Étoiles">
  <Nav home={false} />

  <section id="cadeaux-page" style="padding-top:7rem">
    <div class="container">
      <a href={`${base}/`} class="back-link" style="display:inline-flex;align-items:center;gap:0.4rem;color:var(--text-muted);font-size:0.875rem;margin-bottom:1.5rem;">← Retour à l'accueil</a>
      <div class="section-header">
        <div class="section-tag">Boutique</div>
        <h1 class="section-title">Peluches <em>&amp; cadeaux</em></h1>
        <p class="section-desc">Les petits animaux qui racontent les histoires des Prophètes, à garder près de soi.</p>
      </div>

      <ShopMenu active="cadeaux" />

      <div class="gifts">
        {gifts.map((g, i) => (
          <article class={`gift reveal reveal-delay-${i}`}>
            <img src={`${base}/cadeaux-${g.slug}.jpg`} alt={g.name} loading="lazy" width="1600" height="1195" />
            <div class="gift-body">
              <span class="product-badge soon" style="position:static;align-self:flex-start">Bientôt</span>
              <h2>{g.emoji} {g.name}</h2>
              <p>{g.desc}</p>
              <span class="gift-price">Prix à venir</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer home={false} />
  <Cart />

  <script is:inline src="/petites-etoiles/scripts/main.js"></script>
</Layout>

<style>
  .gifts { display: grid; gap: 2rem; }
  .gift { display: grid; grid-template-columns: 1.3fr 1fr; background: #fff; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-card); }
  .gift:nth-child(even) img { order: 2; }
  .gift img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4 / 3; }
  .gift-body { padding: 2rem 2.2rem; display: flex; flex-direction: column; justify-content: center; gap: 0.75rem; }
  .gift h2 { font-family: var(--font-title); font-size: clamp(1.4rem, 2.6vw, 1.9rem); font-weight: 700; line-height: 1.15; }
  .gift p { color: var(--text-muted); line-height: 1.6; }
  .gift-price { color: var(--text-muted); font-weight: 800; font-size: 0.95rem; }
  @media (max-width: 860px) {
    .gift { grid-template-columns: 1fr; }
    .gift:nth-child(even) img { order: 0; }
    .gift-body { padding: 1.4rem 1.4rem 1.6rem; }
  }
</style>
