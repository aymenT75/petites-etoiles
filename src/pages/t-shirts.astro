---
import Layout from '../layouts/Layout.astro';
import Starfield from '../components/Starfield.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Cart from '../components/Cart.astro';
import ShopMenu from '../components/ShopMenu.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const yt = (id: string) => `https://www.youtube.com/watch?v=${id}`;
const channel = 'https://www.youtube.com/@NajomSaghira';

// `video` = id YouTube de l'histoire du personnage (null si pas encore sortie).
const characters = [
  { slug: 'younes',  name: 'Younes',  ar: 'يونس',    hero: 'Léo le dauphin',        bg: '#f6f4ee', video: 'uRQHHo8f_7A', desc: "Léo le dauphin, qui raconte l'histoire de Younes et du grand poisson." },
  { slug: 'salih',   name: 'Salih',   ar: 'صالح',    hero: 'Alwa la petite chamelle', bg: '#2f5d50', video: '45K4DBB4ljE', desc: "Alwa, la petite chamelle sortie du rocher, qui raconte l'histoire de Salih." },
  { slug: 'maryam',  name: 'Maryam',  ar: 'مريم',    hero: 'Qitta la petite chatte', bg: '#cfe9da', video: 'wDEyUEgT2X4', desc: "Qitta, la petite chatte qui raconte l'histoire de Maryam et du palmier." },
  { slug: 'ibrahim', name: 'Ibrahim', ar: 'إبراهيم', hero: 'Salma la colombe',       bg: '#bcdcf0', video: 'nge4gUgOebU', desc: "Salma la colombe, qui raconte l'histoire d'Ibrahim et du feu devenu fraîcheur." },
  { slug: 'youssef', name: 'Youssef', ar: 'يوسف',    hero: 'Wael le petit loup',     bg: '#1d2b4d', video: null,          desc: "Wael, le petit loup accusé à tort, qui raconte l'histoire de Youssef." },
  { slug: 'lout',    name: 'Lout',    ar: 'لوط',     hero: 'Hamouda le petit âne',   bg: '#efe2c8', video: null,          desc: "Hamouda et sa lanterne, qui racontent le départ de Lout dans la nuit." },
];

const classics = [
  { slug: 'souleymane', name: 'Souleymane', ar: 'سليمان', bg: '#0f1c33', video: 'rFLnZKPyOJA', desc: 'Le cheval ailé, la fourmi, la huppe et le palais de Souleymane.' },
  { slug: 'nouh',       name: 'Nouh',       ar: 'نوح',    bg: '#cfe8f5', video: 'srv5M3jML2E', desc: "L'Arche de Nouh, l'arc-en-ciel et les animaux deux par deux." },
  { slug: 'adam',       name: 'Adam',       ar: 'آدم',    bg: '#c8ead9', video: 'T3opGNWTQdA', desc: "Le jardin d'Éden, le lion, le chameau et le perroquet." },
  { slug: 'mohammed',   name: 'Mohamed',    ar: 'محمد',   bg: '#0f1c33', video: null,          desc: "La grotte, un jeune chameau et la toile d'araignée protectrice." },
];

const sizes = ['2 ans', '4 ans', '6 ans', '8 ans', '10 ans', '12 ans', '14 ans'];
---

<Layout title="T-shirts — Petites Étoiles">
  <Starfield />
  <Nav home={false} />

  <section id="tshirts-page" style="padding-top:7rem">
    <div class="container">
      <a href={`${base}/`} class="back-link" style="display:inline-flex;align-items:center;gap:0.4rem;color:var(--text-muted);font-size:0.875rem;margin-bottom:1.5rem;">← Retour à l'accueil</a>
      <div class="section-header">
        <div class="section-tag">Boutique</div>
        <h1 class="section-title">Les <em>t-shirts</em> Petites Étoiles</h1>
        <p class="section-desc">Des t-shirts enfant 100% coton bio, à l'effigie des petits héros qui racontent les histoires des Prophètes sur notre chaîne.</p>
      </div>

      <ShopMenu active="t-shirts" />

      <h2 class="tee-group-title">Les héros des histoires <span>✨ Nouveau</span></h2>
      <div class="products-grid">
        {characters.map((c, i) => (
          <div class={`product-card reveal reveal-delay-${i % 4}`}>
            <span class="product-badge new">Nouveau</span>
            <div class="product-image product-image--photo">
              <div class="product-image-bg" style={`background:${c.bg}`}></div>
              <img src={`${base}/tshirt-${c.slug}.jpg`} alt={`T-shirt ${c.name} — ${c.hero}`} class="product-photo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
              <div class="product-image-fallback" style="display:none"><span>👕</span></div>
            </div>
            <div class="product-body">
              <div class="product-name">T-shirt {c.name} <span class="tee-ar">{c.ar}</span></div>
              <div class="tee-hero">avec {c.hero}</div>
              <div class="product-desc">{c.desc} 100% coton bio.</div>
              <div class="size-chips">
                {sizes.map((s) => (
                  <button class="size-chip" type="button" onclick="this.parentElement.querySelectorAll('.size-chip').forEach(b => b.classList.remove('active')); this.classList.add('active')">{s}</button>
                ))}
              </div>
              <div class="product-footer">
                <div class="product-price" style="font-size:0.95rem;color:var(--text-muted);font-weight:600">Prix à venir</div>
                {c.video
                  ? <a class="tee-story" href={yt(c.video)} target="_blank" rel="noopener">▶ Voir l'histoire</a>
                  : <a class="tee-story tee-story--soon" href={channel} target="_blank" rel="noopener">Histoire bientôt</a>}
              </div>
            </div>
          </div>
        ))}
      </div>

      <h2 class="tee-group-title">La collection classique</h2>
      <div class="products-grid">
        {classics.map((c, i) => (
          <div class={`product-card reveal reveal-delay-${i % 4}`}>
            <div class="product-image product-image--photo">
              <div class="product-image-bg" style={`background:${c.bg}`}></div>
              <img src={`${base}/tshirt-${c.slug}.jpg`} alt={`T-shirt ${c.name}`} class="product-photo" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
              <div class="product-image-fallback" style="display:none"><span>👕</span></div>
            </div>
            <div class="product-body">
              <div class="product-name">T-shirt {c.name} <span class="tee-ar">{c.ar}</span></div>
              <div class="product-desc">{c.desc} 100% coton bio.</div>
              <div class="size-chips">
                {sizes.map((s) => (
                  <button class="size-chip" type="button" onclick="this.parentElement.querySelectorAll('.size-chip').forEach(b => b.classList.remove('active')); this.classList.add('active')">{s}</button>
                ))}
              </div>
              <div class="product-footer">
                <div class="product-price" style="font-size:0.95rem;color:var(--text-muted);font-weight:600">Prix à venir</div>
                {c.video && <a class="tee-story" href={yt(c.video)} target="_blank" rel="noopener">▶ Voir l'histoire</a>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer home={false} />
  <Cart />

  <script is:inline src="/petites-etoiles/scripts/main.js"></script>
</Layout>

<style>
  .tee-group-title { font-size: 1.35rem; font-weight: 800; margin: 2.5rem 0 1.25rem; display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .tee-group-title span { font-size: 0.72rem; font-weight: 700; color: var(--bg-deep); background: var(--gold); border-radius: 50px; padding: 0.2rem 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .tee-ar { font-family: var(--font-arabic); color: var(--gold); margin-inline-start: 0.3rem; }
  .tee-hero { font-size: 0.82rem; color: var(--gold); font-weight: 600; margin: -0.2rem 0 0.4rem; }
  .product-footer { gap: 0.75rem; flex-wrap: wrap; }
  .tee-story { font-size: 0.8rem; font-weight: 700; color: var(--gold); border: 1px solid rgba(212,168,67,0.4); border-radius: 8px; padding: 0.35rem 0.75rem; transition: all var(--transition); }
  .tee-story:hover { background: var(--gold); color: var(--bg-deep); }
  .tee-story--soon { color: var(--text-muted); border-color: rgba(255,255,255,0.15); }
</style>
